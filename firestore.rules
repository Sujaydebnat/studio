rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Orders collection: Authenticated users can read, list and write
    match /orders/{orderId} {
      // Login kora thakle read/list kora jabe
      allow read, list: if request.auth != null;
      
      // Prototyping-er jonno authenticated users-ke write allow kora hoyeche
      allow write: if request.auth != null;

      // Updates sub-collection
      match /updates/{updateId} {
        allow read, write: if request.auth != null;
      }
    }

    // Onno sob collection-er jonno (Users management ebong login logic-er jonno dorkar)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // Allow public to GET a single order for tracking (must know the ID)
    match /orders/{orderId} {
      allow get: if true;
    }
  }
}