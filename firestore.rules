rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- CORE HELPERS ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    // List of recognized super admins for global oversight
    function isSuperAdmin() {
      let superAdminUIDs = [
        'GBknAJHg5lRKims8hdy6AC6q3qO2', 
        'NWLuwbVTGYcpeeOu2l8zcFLOZSI3', 
        'uyNwlQz5VucqI6QXNWn9sIC89k83'
      ];
      return isSignedIn() && request.auth.uid in superAdminUIDs;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Helper to check if a user belongs to a shop or is a super admin
    function belongsToShop(shopId) {
      return isSignedIn() && (isSuperAdmin() || getUserData().shopId == shopId);
    }

    // --- COLLECTION RULES ---

    // Global User Profiles: Multi-tenant aware
    match /users/{userId} {
      // Allowed to read if: it's your own profile, you're a super admin, or you're the shop owner of that user
      allow read: if isSignedIn() && (
        request.auth.uid == userId || 
        isSuperAdmin() || 
        (getUserData().role == 'shop_owner' && getUserData().shopId == resource.data.shopId) ||
        (getUserData().role == 'staff' && getUserData().shopId == resource.data.shopId)
      );
      
      // Allowed to create if: you're signing up (self) OR you're a shop owner creating staff for your shop
      allow create: if isSignedIn() && (
        request.auth.uid == userId ||
        isSuperAdmin() ||
        (request.resource.data.role == 'staff' && getUserData().role == 'shop_owner' && getUserData().shopId == request.resource.data.shopId)
      );
      
      // Allowed to update if: it's your own profile, or you're a super admin, or you're the shop owner managing your staff
      allow update: if isSignedIn() && (
        request.auth.uid == userId || 
        isSuperAdmin() ||
        (getUserData().role == 'shop_owner' && getUserData().shopId == resource.data.shopId)
      );
      
      allow delete: if isSuperAdmin() || (getUserData().role == 'shop_owner' && getUserData().shopId == resource.data.shopId);
    }

    // Root Shops
    match /shops/{shopId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSuperAdmin() || (isSignedIn() && request.auth.uid == resource.data.ownerId);

      // Orders: Nested inside shops for isolation
      match /orders/{orderId} {
        allow read: if belongsToShop(shopId);
        allow create, update: if belongsToShop(shopId);
        allow delete: if isSuperAdmin() || (belongsToShop(shopId) && getUserData().role == 'shop_owner');
        
        match /updates/{updateId} {
          allow read, write: if belongsToShop(shopId);
        }
      }

      // Catalog items
      match /catalog/{itemId} {
        allow read: if true; 
        allow write: if isSuperAdmin() || (belongsToShop(shopId) && getUserData().role == 'shop_owner');
      }

      // Categories & Subcategories
      match /categories/{catId} {
        allow read: if true;
        allow write: if belongsToShop(shopId);
        
        match /subcategories/{subId} {
          allow read: if true;
          allow write: if belongsToShop(shopId);
        }
      }
    }

    // Global Attendance Logs
    match /attendance/{attId} {
      allow read: if isSuperAdmin() || (isSignedIn() && belongsToShop(resource.data.shopId));
      allow write: if isSignedIn() && belongsToShop(request.resource.data.shopId);
    }

    // Custom Staff Fields
    match /staff_fields/{fieldId} {
      allow read: if belongsToShop(resource.data.shopId);
      allow write: if belongsToShop(request.resource.data.shopId);
    }

    // Support for Super Admin Global Monitoring (CollectionGroup)
    match /{path=**}/orders/{orderId} {
      allow read: if isSuperAdmin();
    }
  }
}