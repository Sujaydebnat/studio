
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Prototyping mode: Allow all authenticated users to read/write all collections.
    // This allows Admin and Staff to manage orders and users once logged in.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

    // Public tracking portal access: Allows anyone to view a specific order by ID
    // but not to list the entire collection or modify data.
    match /orders/{orderId} {
      allow get: if true;
    }
    
    // Safety check for user profiles: although the catch-all covers it, 
    // keeping it explicit for clarity in prototyping.
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }
  }
}
