
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- HELPER FUNCTIONS ---
    
    // চেক করে ইউজার লগইন করা আছে কি না
    function isSignedIn() {
      return request.auth != null;
    }

    // চেক করে ইউজার কি সুপার অ্যাডমিন কি না (নির্দিষ্ট UID এর মাধ্যমে)
    function isSuperAdmin() {
      let superAdminUIDs = [
        'GBknAJHg5lRKims8hdy6AC6q3qO2', 
        'NWLuwbVTGYcpeeOu2l8zcFLOZSI3', 
        'uyNwlQz5VucqI6QXNWn9sIC89k83'
      ];
      return isSignedIn() && request.auth.uid in superAdminUIDs;
    }

    // ইউজারের প্রোফাইল ডেটা নিয়ে আসে
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // চেক করে ইউজার ওই নির্দিষ্ট শপের মেম্বার কি না
    function belongsToShop(shopId) {
      return isSignedIn() && (isSuperAdmin() || getUserData().shopId == shopId);
    }

    // --- COLLECTION RULES ---

    // Users collection: নিজের প্রোফাইল নিজে এডিট করতে পারবে, অ্যাডমিন সব পারবে
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin() || getUserData().shopId == resource.data.shopId);
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    // Shops collection
    match /shops/{shopId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSuperAdmin() || (isSignedIn() && request.auth.uid == resource.data.ownerId);

      // Orders subcollection: শপের মেম্বাররা অ্যাক্সেস পাবে
      match /orders/{orderId} {
        allow read: if belongsToShop(shopId);
        allow create, update: if belongsToShop(shopId);
        allow delete: if isSuperAdmin() || (belongsToShop(shopId) && getUserData().role == 'shop_owner');
        
        // অর্ডারের ভেতরকার আপডেট বা চ্যাট মেসেজ
        match /updates/{updateId} {
          allow read, write: if belongsToShop(shopId);
        }
      }

      // Catalog subcollection: পাবলিকলি দেখা যাবে, কিন্তু শপ ওনার ছাড়া কেউ এডিট করতে পারবে না
      match /catalog/{itemId} {
        allow read: if true; 
        allow write: if isSuperAdmin() || (belongsToShop(shopId) && getUserData().role == 'shop_owner');
      }

      // Categories: শপ কনফিগারেশন
      match /categories/{catId} {
        allow read: if true;
        allow write: if belongsToShop(shopId);
        
        match /subcategories/{subId} {
          allow read: if true;
          allow write: if belongsToShop(shopId);
        }
      }
    }

    // Attendance records
    match /attendance/{attId} {
      allow read: if isSuperAdmin() || (isSignedIn() && belongsToShop(resource.data.shopId));
      allow write: if isSignedIn() && belongsToShop(request.resource.data.shopId);
    }

    // Staff Fields: কাস্টম কলাম সেটিংস
    match /staff_fields/{fieldId} {
      allow read, write: if belongsToShop(request.resource.data.shopId || resource.data.shopId);
    }

    // Global support for Super Admin to query across collections
    match /{path=**}/orders/{orderId} {
      allow read: if isSuperAdmin();
    }
  }
}
