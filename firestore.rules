
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Prototyping mode: Allow all authenticated users to read/write all collections
    // and specifically allow public access to single order tracking.
    
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

    match /orders/{orderId} {
      // Public-facing tracking page access
      allow get: if true;
    }
    
    // Safety check for user profiles
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }
  }
}
