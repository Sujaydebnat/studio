
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Check if user has an authorized profile in users collection
    function isAuthorized() {
      return request.auth != null && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    
    // Check if user is specifically an admin
    function isAdmin() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Allow staff/admin to check authorization list during login logic
    match /users/{userId} {
      // Allow read for initial role detection and authorization check
      allow read: if true; 
      // Only Admin can create or delete staff authorizations
      allow write: if isAdmin() || !exists(/databases/$(database)/documents/users/$(userId)); 
    }
    
    // Orders
    match /orders/{orderId} {
      allow read: if true; // Customers can track, Staff can see tasks
      allow create: if request.auth != null; // Restrict order creation in UI, but allow authorized users
      allow update: if request.auth != null; // Allow notes and status changes
      allow delete: if isAdmin();
      
      // Updates / Messages
      match /updates/{updateId} {
        allow read, write: if true; // Allow chat between admin and staff
      }
    }
  }
}
