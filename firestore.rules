
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isSignedIn() && getUserData().role == 'super_admin';
    }

    function isOwnerOfShop(shopId) {
      return isSignedIn() && getUserData().role == 'admin' && getUserData().shopId == shopId;
    }

    function isStaffOfShop(shopId) {
      return isSignedIn() && getUserData().shopId == shopId;
    }

    // Rules for Shops
    match /shops/{shopId} {
      allow read: if isSuperAdmin() || isOwnerOfShop(shopId) || true; // Public access for catalog
      allow create: if isSignedIn();
      allow update, delete: if isSuperAdmin() || isOwnerOfShop(shopId);
    }

    // Rules for Users
    match /users/{userId} {
      allow read: if isSuperAdmin() || (isSignedIn() && (request.auth.uid == userId || getUserData().shopId == resource.data.shopId));
      allow create: if isSignedIn();
      allow update: if isSuperAdmin() || (isSignedIn() && (request.auth.uid == userId || isOwnerOfShop(request.resource.data.shopId)));
      allow delete: if isSuperAdmin() || (isSignedIn() && isOwnerOfShop(resource.data.shopId));
    }

    // Rules for Orders
    match /orders/{orderId} {
      allow read: if isSuperAdmin() || (isSignedIn() && isStaffOfShop(resource.data.shopId));
      allow create: if isSignedIn() && isStaffOfShop(request.resource.data.shopId);
      allow update: if isSignedIn() && isStaffOfShop(resource.data.shopId);
      allow delete: if isSuperAdmin() || isOwnerOfShop(resource.data.shopId);
    }

    // Rules for Catalog/Categories
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isSignedIn() && isStaffOfShop(request.resource.data.shopId);
      
      match /subcategories/{subId} {
        allow read: if true;
        allow write: if isSignedIn();
      }
    }

    match /catalog/{itemId} {
      allow read: if true;
      allow write: if isSignedIn() && isStaffOfShop(request.resource.data.shopId);
    }

    // Rules for Attendance
    match /attendance/{attendanceId} {
      allow read: if isSuperAdmin() || (isSignedIn() && isStaffOfShop(resource.data.shopId));
      allow create: if isSignedIn() && isStaffOfShop(request.resource.data.shopId);
      allow update: if isSuperAdmin() || isOwnerOfShop(resource.data.shopId);
    }

    // Global catch-all
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
