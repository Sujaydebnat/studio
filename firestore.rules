
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isSignedIn() && getUserData().role == 'super_admin';
    }

    function isShopOwner(shopId) {
      return isSignedIn() && getUserData().role == 'shop_owner' && getUserData().shopId == shopId;
    }

    function isStaffOfShop(shopId) {
      return isSignedIn() && getUserData().shopId == shopId;
    }

    // Rules for Shops
    match /shops/{shopId} {
      allow read: if isSuperAdmin() || isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSuperAdmin() || isShopOwner(shopId);
    }

    // Rules for Users
    match /users/{userId} {
      allow read: if isSuperAdmin() || (isSignedIn() && (request.auth.uid == userId || getUserData().shopId == resource.data.shopId));
      allow create: if isSignedIn();
      allow update: if isSuperAdmin() || (isSignedIn() && (request.auth.uid == userId || isShopOwner(request.resource.data.shopId)));
      allow delete: if isSuperAdmin() || (isSignedIn() && isShopOwner(resource.data.shopId));
    }

    // Rules for Orders
    match /orders/{orderId} {
      allow read: if isSuperAdmin() || (isSignedIn() && isStaffOfShop(resource.data.shopId));
      allow create: if isSignedIn() && isStaffOfShop(request.resource.data.shopId);
      allow update: if isSignedIn() && isStaffOfShop(resource.data.shopId);
      allow delete: if isSuperAdmin() || isShopOwner(resource.data.shopId);
    }

    // Global catch-all
    match /{document=**} {
      allow read: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }
  }
}
