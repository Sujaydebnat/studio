
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /**
     * PROTOTYPING RULES
     * Allows all authenticated users to read/write all documents.
     */
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

    /**
     * PUBLIC TRACKING RULE
     * Allows anyone to get specific orders for the customer tracking portal.
     */
    match /orders/{orderId} {
      allow get: if true;
    }
    
    /**
     * USER PROFILE RULES
     */
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
