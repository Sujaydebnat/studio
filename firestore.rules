
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Check if user is specifically an admin
    function isAdmin() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Allow staff/admin to check authorization list during login logic
    match /users/{userId} {
      allow read: if true; 
      // Only Admin can create or delete staff authorizations
      allow write, delete: if isAdmin() || !exists(/databases/$(database)/documents/users/$(userId)); 
    }
    
    // Orders
    match /orders/{orderId} {
      allow read: if true; 
      // Only Admin can place orders
      allow create: if isAdmin();
      // Allow updates for both admin and staff (notes/status)
      allow update: if request.auth != null;
      allow delete: if isAdmin();
      
      // Updates / Messages
      match /updates/{updateId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
