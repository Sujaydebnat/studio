
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /**
     * PROTOTYPING RULES
     * Allows authenticated users to read and write.
     * Restriction: Only 'admin' role can create new orders.
     */
    
    function isUserAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isUserAuthenticated() && getUserData().role == 'admin';
    }

    match /users/{userId} {
      allow read, write: if isUserAuthenticated() && request.auth.uid == userId;
      // Admins can manage all users
      allow read, write: if isAdmin();
    }

    match /orders/{orderId} {
      // Authenticated users can read/list orders
      allow read, list: if isUserAuthenticated();
      // Only Admin can create new orders
      allow create: if isAdmin();
      // Both Admin and Staff can update status or details
      allow update: if isUserAuthenticated();
      // Only Admin can delete
      allow delete: if isAdmin();
      
      // Public tracking get (only for specific order lookup)
      allow get: if true;
    }

    match /orders/{orderId}/files/{fileId} {
      allow read, write: if isUserAuthenticated();
      allow get: if true;
    }
    
    match /workTypes/{workTypeId} {
      allow read: if isUserAuthenticated();
      allow write: if isAdmin();
    }

    match /customers/{customerId} {
      allow read, write: if isUserAuthenticated();
    }
  }
}
