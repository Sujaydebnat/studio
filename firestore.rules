rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /**
     * TESTING MODE RULES
     * Allows all reads and writes for authenticated users during development.
     * Also allows read access for anonymous tracking if required.
     */
    match /{document=**} {
      allow read, write: if true;
    }
    
    // Specific collection rules for future security hardening
    match /orders/{orderId} {
      allow read, list: if request.auth != null || resource.data.customerPhoneNumber != null;
      allow write: if request.auth != null;
    }
  }
}