
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper to get current user data
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Helper to check if user belongs to the shop in the resource
    function belongsToShop(shopId) {
      return request.auth != null && getUserData().shopId == shopId;
    }

    match /shops/{shopId} {
      allow read: if true; // Public can see shop info
      allow write: if request.auth != null; // Registered users can create shops
    }

    match /users/{userId} {
      allow read, write: if true; // Allow initial setup, in prod restrict to owner/admin
    }

    match /orders/{orderId} {
      allow read, write: if true; // In prod restrict by belongsToShop(resource.data.shopId)
    }

    match /catalog/{itemId} {
      allow read: if true; // Public catalog
      allow write: if request.auth != null; 
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null;
      
      match /subcategories/{subcategoryId} {
        allow read, write: if true;
      }
    }

    match /staff_fields/{fieldId} {
      allow read, write: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
