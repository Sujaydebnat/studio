rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * PRINTFLOW MANAGE SECURITY RULES
     * 
     * CORE PHILOSOPHY:
     * This ruleset implements a role-based access control (RBAC) model combined with denormalized 
     * identity for anonymous customer tracking. It prioritizes internal staff/admin efficiency 
     * while securing customer data via specific identifiers.
     * 
     * DATA STRUCTURE:
     * - /users: Profiles for Admin and Staff.
     * - /customers: Contact records for external clients (no system accounts).
     * - /workTypes: Global configuration for service types.
     * - /orders: Centralized order tracking with subcollections for files.
     * 
     * KEY SECURITY DECISIONS:
     * 1. Authorization Independence: We use denormalized fields like 'adminId', 'assignedStaffId', 
     *    and 'customerPhoneNumber' on Order and OrderFile documents to allow fast, 
     *    single-document security checks without nested get() calls.
     * 2. Internal vs. External: Only 'Admin' and 'Staff' roles (verified via the /users collection) 
     *    can manage customers and orders.
     * 3. Anonymous Tracking: Anonymous users can access orders and specific preview files 
     *    if the document contains a 'customerPhoneNumber' that matches their authenticated 
     *    phone number. The application must filter queries by this phone number to satisfy the rules.
     * 4. Prototyping Flexibility: We strictly enforce "who" can write but allow flexibility 
     *    on "what" is written (data shapes) to support rapid development.
     */

    // --- Global Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Retrieves user data for role-based checks
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn() && getUserData().role == role;
    }

    function isAdmin() {
      return hasRole('Admin');
    }

    function isStaff() {
      return hasRole('Staff');
    }

    function isInternal() {
      return isAdmin() || isStaff();
    }

    // Validates existence and ownership for updates/deletes
    function isExistingOwner(userId) {
      return resource != null && isOwner(userId);
    }

    // --- Collection Rules ---

    /**
     * @description Rules for system users (Admin/Staff). Owners manage profiles; Admins manage all.
     * @path /users/{userId}
     * @allow (get) If user is the owner or an Admin.
     * @deny (update) If user is not the owner and not an Admin.
     * @principle Path-based ownership and global role-based access.
     */
    match /users/{userId} {
      allow get, list: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) || isAdmin();
      allow update: if (isExistingOwner(userId) || isAdmin()) && (request.resource.data.id == resource.data.id);
      allow delete: if isAdmin();
    }

    /**
     * @description Customer records management. Restricted to authenticated internal staff.
     * @path /customers/{customerId}
     * @allow (create) If the user has an Admin or Staff role.
     * @deny (list) If the user is an anonymous customer.
     * @principle Internal structural segregation; customers do not have system accounts.
     */
    match /customers/{customerId} {
      allow read: if isInternal();
      allow create: if isInternal();
      allow update: if isInternal() && resource != null;
      allow delete: if isAdmin();
    }

    /**
     * @description Global configuration for print services. Readable by staff, managed by Admin.
     * @path /workTypes/{workTypeId}
     * @allow (list) If user is Staff or Admin.
     * @deny (create) If user is Staff (only Admins can create config).
     * @principle Read-only access for operational roles, write access for administrative roles.
     */
    match /workTypes/{workTypeId} {
      allow read: if isInternal();
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Order management. Uses denormalized IDs for staff assignment and customer tracking.
     * @path /orders/{orderId}
     * @allow (get) If internal staff OR anonymous user matching the customerPhoneNumber.
     * @deny (create) If the user is not signed in with an internal account.
     * @principle Denormalization for authorization; enables anonymous access via phone number.
     */
    match /orders/{orderId} {
      // Internal staff can get any order.
      // Authenticated customer can get if their authenticated phone number matches the order's customerPhoneNumber.
      allow get: if isInternal() || (
        isSignedIn() &&
        request.auth.token.phone_number != null &&
        resource.data.customerPhoneNumber == request.auth.token.phone_number
      );
      
      // Internal staff can list any order.
      // Authenticated customer can list if their authenticated phone number matches the order's customerPhoneNumber.
      // This rule implicitly forces clients to query for their own phone number if not internal.
      allow list: if isInternal() || (
        isSignedIn() &&
        request.auth.token.phone_number != null &&
        resource.data.customerPhoneNumber == request.auth.token.phone_number
      );
      
      allow create: if isInternal();
      allow update: if isInternal() && resource != null;
      allow delete: if isAdmin();

      /**
       * @description Files associated with orders. Inherits parent access logic via denormalization.
       * @path /orders/{orderId}/files/{fileId}
       * @allow (get) If internal OR anonymous user for 'PreviewImage' purposes, matching phone number.
       * @deny (update) If internal staff tries to change the orderId (relational integrity).
       * @principle Authorization independence; file access decided by its own denormalized fields.
       */
      match /files/{fileId} {
        // Internal staff can get any file.
        // Authenticated customer can get if their authenticated phone number matches the file's customerPhoneNumber,
        // AND the filePurpose is 'PreviewImage'.
        allow get: if isInternal() || (
          isSignedIn() &&
          request.auth.token.phone_number != null &&
          resource.data.customerPhoneNumber == request.auth.token.phone_number &&
          resource.data.filePurpose == 'PreviewImage'
        );
        
        // Internal staff can list any file.
        // Authenticated customer can list if their authenticated phone number matches the file's customerPhoneNumber.
        // This rule implicitly forces clients to query for their own phone number if not internal.
        allow list: if isInternal() || (
          isSignedIn() &&
          request.auth.token.phone_number != null &&
          resource.data.customerPhoneNumber == request.auth.token.phone_number
        );
        
        allow create: if isInternal();
        allow update: if isInternal() && resource != null && (request.resource.data.orderId == resource.data.orderId);
        allow delete: if isInternal() && resource != null;
      }
    }
  }
}