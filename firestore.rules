
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- HELPER FUNCTIONS ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      let superAdminUIDs = ['GBknAJHg5lRKims8hdy6AC6q3qO2', 'NWLuwbVTGYcpeeOu2l8zcFLOZSI3', 'uyNwlQz5VucqI6QXNWn9sIC89k83'];
      return isSignedIn() && request.auth.uid in superAdminUIDs;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function belongsToShop(shopId) {
      return isSignedIn() && getUserData().shopId == shopId;
    }

    // --- COLLECTION RULES ---

    // Root Users collection for authentication profiles
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin() || getUserData().shopId == resource.data.shopId);
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    // Shop hierarchy
    match /shops/{shopId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSuperAdmin() || (isSignedIn() && request.auth.uid == resource.data.ownerId);

      // Orders subcollection
      match /orders/{orderId} {
        allow read: if isSuperAdmin() || belongsToShop(shopId);
        allow create, update: if belongsToShop(shopId);
        allow delete: if isSuperAdmin() || (belongsToShop(shopId) && getUserData().role == 'shop_owner');
        
        match /updates/{updateId} {
          allow read, write: if belongsToShop(shopId);
        }
      }

      // Catalog subcollection
      match /catalog/{itemId} {
        allow read: if true; // Public browsing
        allow write: if isSuperAdmin() || (belongsToShop(shopId) && getUserData().role == 'shop_owner');
      }

      // Categories subcollection
      match /categories/{catId} {
        allow read: if true;
        allow write: if belongsToShop(shopId);
        
        match /subcategories/{subId} {
          allow read: if true;
          allow write: if belongsToShop(shopId);
        }
      }
    }

    // Attendance
    match /attendance/{attId} {
      allow read: if isSuperAdmin() || (isSignedIn() && getUserData().shopId == resource.data.shopId);
      allow write: if isSignedIn() && getUserData().shopId == request.resource.data.shopId;
    }

    // Support collectionGroup for Super Admins
    match /{path=**}/orders/{orderId} {
      allow read: if isSuperAdmin();
    }
  }
}
