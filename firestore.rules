rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /**
     * TESTING MODE RULES
     * Allows all reads and writes. Use only for rapid prototyping and testing.
     * Ensure you switch back to specific rules before production.
     */
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
