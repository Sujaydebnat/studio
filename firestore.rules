rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /**
     * PROTOTYPING RULES
     * Allows authenticated users to access all collections for prototyping.
     * This ensures the Admin Dashboard can load profiles and orders.
     */
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

    // Specific rules for public order tracking (if implemented for anonymous users)
    match /orders/{orderId} {
      allow read: if request.auth != null || resource.data.customerPhoneNumber != null;
    }
  }
}