
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Safety check if user is an admin
    function isAdmin() {
      return request.auth != null && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users collection: Necessary for login role detection and Staff Management
    match /users/{userId} {
      // Allow all authenticated users to read profiles (needed for login/redirection logic)
      allow read: if request.auth != null;
      
      // Allow a user to create/update their own profile (initial activation)
      // Or allow Admin to manage all staff profiles
      allow write: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      allow delete: if isAdmin();
    }
    
    // Orders collection
    match /orders/{orderId} {
      // Allow public to GET a single order for tracking (must know the ID)
      allow get: if true;
      
      // Allow authenticated users (Admin/Staff) to LIST orders for their dashboards
      allow list: if request.auth != null;
      
      // Only Admin can create new orders
      allow create: if isAdmin();
      
      // Allow Admins and assigned Staff to update orders (notes, status, previews)
      allow update: if request.auth != null;
      
      // Only Admin can delete orders
      allow delete: if isAdmin();
      
      // Updates / Messages sub-collection
      match /updates/{updateId} {
        // Authenticated users can read and write updates for communication
        allow read, write: if request.auth != null;
      }
    }
  }
}
