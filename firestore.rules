
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /**
     * PROTOTYPING RULES
     * Allows all authenticated users to read/write all documents.
     * This ensures Admin Dashboard and Staff portal work perfectly.
     */
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

    /**
     * USER PROFILE RULES
     * Allow users to read their own profile for role verification during login.
     */
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
    }

    /**
     * PUBLIC TRACKING RULE
     * Allows anyone (including anonymous/unauthenticated users) to get a specific order document.
     * This is required for the Customer Tracking page to work.
     */
    match /orders/{orderId} {
      allow get: if true;
    }
  }
}
