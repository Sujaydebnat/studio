
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /**
     * PROTOTYPING RULES
     * Allows any authenticated user to read and write to all collections.
     * This ensures that while testing, permissions do not block the workflow.
     */
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // Public tracking get for customers
    match /orders/{orderId} {
      allow get: if true;
    }
    
    match /orders/{orderId}/files/{fileId} {
      allow get: if true;
    }
  }
}
