rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * PrintFlow Manage Security Rules
     * Optimized for Multi-Tenant Isolation and Role-Based Access.
     */

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    /** 
     * @description Checks if user is a Super Admin.
     * Includes hardcoded UIDs for emergency recovery and system provisioning.
     */
    function isSuperAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid)) ||
        request.auth.uid == 'uyNwlQz5VucqI6QXNWn9sIC89k83' ||
        request.auth.uid == 'NWLuwbVTGYcpeeOu2l8zcFLOZSI3' ||
        request.auth.uid == 'GBknAJHg5lRKims8hdy6AC6q3qO2' ||
        request.auth.uid == 'cRm3xfHwoJWpH2iL6RejsJTlREH3'
      );
    }

    /** @description Fetches the current user's profile document. */
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow get: if isSignedIn();
      /** 
       * @description Allows listing users if the query is filtered by shopId.
       * This unblocks the Staff Directory while maintaining multi-tenant isolation.
       */
      allow list: if isSignedIn() && (isSuperAdmin() || (resource == null || resource.data.shopId == getUserData().shopId));
      allow create, update: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    match /roles_admin/{userId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /roles_staff/{userId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /shops/{shopId} {
      allow get: if true;
      allow list: if isSignedIn();
      allow write: if isSuperAdmin() || (isSignedIn() && getUserData().shopId == shopId);

      match /orders/{orderId} {
        allow read, write: if isSignedIn() && (isSuperAdmin() || getUserData().shopId == shopId);
        
        match /updates/{updateId} {
          allow read, write: if isSignedIn() && (isSuperAdmin() || getUserData().shopId == shopId);
        }
      }
    }

    match /catalog/{itemId} {
      allow read: if true;
      allow write: if isSignedIn() && (isSuperAdmin() || getUserData().role == 'shop_owner');
    }

    match /categories/{catId} {
      allow read: if true;
      allow write: if isSignedIn() && (isSuperAdmin() || getUserData().role == 'shop_owner');
      
      match /subcategories/{subId} {
        allow read: if true;
        allow write: if isSignedIn() && (isSuperAdmin() || getUserData().role == 'shop_owner');
      }
    }

    match /attendance/{id} {
      allow read: if isSignedIn() && (isSuperAdmin() || getUserData().shopId == resource.data.shopId || request.auth.uid == resource.data.staffId);
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (isSuperAdmin() || getUserData().shopId == resource.data.shopId || request.auth.uid == resource.data.staffId);
    }

    match /staff_fields/{id} {
      allow read: if isSignedIn() && (isSuperAdmin() || getUserData().shopId == resource.data.shopId);
      allow write: if isSignedIn() && (isSuperAdmin() || getUserData().role == 'shop_owner');
    }
  }
}