
{
  "entities": {
    "User": {
      "title": "User",
      "type": "object",
      "description": "Represents an administrative or staff user. Roles: 'admin', 'staff'.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "username": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "photoUrl": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "staff"] },
        "password": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "username", "email", "role"]
    },
    "Order": {
      "title": "Order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerName": { "type": "string" },
        "phone": { "type": "string" },
        "workType": { 
          "type": "string",
          "enum": ["GIFT", "FLEX", "DIGITAL PAPER", "PHOTOPAPER", "GUM PAPER", "LOGO", "PLATE", "REDIEM", "VINAIL", "DTF", "UV"]
        },
        "subWorkType": {
          "type": "string",
          "enum": ["VISITING CARD", "TABLE MENU CARD", "HAND MENU CARD", "PVC CARD"],
          "description": "Specific sub-category for DIGITAL PAPER"
        },
        "status": { "type": "string" },
        "width": { "type": "string" },
        "height": { "type": "string" },
        "unit": { "type": "string", "enum": ["Inches", "mm", "cm", "ft"] },
        "quantity": { "type": "string" },
        "additionalDetails": { "type": "string" },
        "referenceImages": { "type": "array", "items": { "type": "string" } },
        "adminId": { "type": "string" },
        "assignedStaffId": { "type": "string" },
        "priority": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "OrderUpdate": {
      "title": "OrderUpdate",
      "type": "object",
      "description": "Messages/Notes between Admin and Staff for a specific order.",
      "properties": {
        "id": { "type": "string" },
        "orderId": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "senderRole": { "type": "string" },
        "message": { "type": "string" },
        "fileUrl": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["password", "google"]
  },
  "firestore": {
    "/users/{userId}": { "schema": "#/backend/entities/User", "description": "User profiles with roles." },
    "/orders/{orderId}": { "schema": "#/backend/entities/Order", "description": "Print orders." },
    "/orders/{orderId}/updates/{updateId}": { "schema": "#/backend/entities/OrderUpdate", "description": "Messages for an order." }
  }
}
