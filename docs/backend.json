
{
  "entities": {
    "Shop": {
      "title": "Shop",
      "type": "object",
      "description": "Represents a tenant shop in the system.",
      "properties": {
        "id": { "type": "string" },
        "shopName": { "type": "string" },
        "ownerId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "shopName", "ownerId"]
    },
    "User": {
      "title": "User",
      "type": "object",
      "description": "Represents an administrative or staff user associated with a shop.",
      "properties": {
        "id": { "type": "string" },
        "shopId": { "type": "string" },
        "name": { "type": "string" },
        "username": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "photoUrl": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "staff", "Designer", "Manager"] },
        "department": { "type": "string" },
        "address": { "type": "string" },
        "joiningDate": { "type": "string", "format": "date" },
        "salary": { "type": "string" },
        "status": { "type": "string", "enum": ["Active", "Inactive"] },
        "password": { "type": "string" },
        "customFields": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "email", "role", "shopId"]
    },
    "StaffField": {
      "title": "StaffField",
      "type": "object",
      "description": "Custom column definition for a shop's staff.",
      "properties": {
        "id": { "type": "string" },
        "shopId": { "type": "string" },
        "fieldName": { "type": "string" },
        "fieldType": { "type": "string", "enum": ["text", "number", "date", "dropdown"] },
        "options": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "fieldName", "fieldType", "shopId"]
    },
    "Order": {
      "title": "Order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "shopId": { "type": "string" },
        "billNumber": { "type": "string" },
        "customerName": { "type": "string" },
        "customerEmail": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "workTypes": { "type": "array", "items": { "type": "string" } },
        "orderItems": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": { "type": "string" },
              "subCategory": { "type": "string" },
              "size": { "type": "string" },
              "qty": { "type": "string" }
            }
          }
        },
        "status": { "type": "string" },
        "totalBill": { "type": "string" },
        "deliveryDate": { "type": "string", "format": "date" },
        "additionalDetails": { "type": "string" },
        "referenceImages": { "type": "array", "items": { "type": "string" } },
        "previews": { "type": "array", "items": { "type": "string" } },
        "adminId": { "type": "string" },
        "assignedStaffId": { "type": "string" },
        "priority": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["shopId"]
    },
    "CatalogItem": {
      "title": "CatalogItem",
      "type": "object",
      "description": "Shop-specific products or services.",
      "properties": {
        "id": { "type": "string" },
        "shopId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "subCategory": { "type": "string" },
        "imageUrl": { "type": "string" },
        "startingPrice": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "category", "shopId"]
    },
    "Category": {
      "title": "Category",
      "type": "object",
      "description": "Shop-specific work categories.",
      "properties": {
        "id": { "type": "string" },
        "shopId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "shopId"]
    }
  },
  "auth": {
    "providers": ["password", "google"]
  },
  "firestore": {
    "/shops/{shopId}": { "schema": "#/backend/entities/Shop", "description": "Tenants." },
    "/users/{userId}": { "schema": "#/backend/entities/User", "description": "Profiles." },
    "/staff_fields/{fieldId}": { "schema": "#/backend/entities/StaffField", "description": "Shop-specific custom columns." },
    "/orders/{orderId}": { "schema": "#/backend/entities/Order", "description": "Shop-specific orders." },
    "/catalog/{itemId}": { "schema": "#/backend/entities/CatalogItem", "description": "Shop-specific catalog items." },
    "/categories/{categoryId}": { "schema": "#/backend/entities/Category", "description": "Shop-specific categories." }
  }
}
