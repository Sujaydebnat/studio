
{
  "entities": {
    "User": {
      "title": "User",
      "type": "object",
      "description": "Represents an administrative or staff user. Roles: 'admin', 'staff'.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "username": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "photoUrl": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "staff"] },
        "password": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "username", "email", "role"]
    },
    "Order": {
      "title": "Order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "billNumber": { "type": "string" },
        "customerName": { "type": "string" },
        "customerEmail": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "workTypes": { "type": "array", "items": { "type": "string" } },
        "orderItems": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": { "type": "string" },
              "subCategory": { "type": "string" },
              "size": { "type": "string" },
              "qty": { "type": "string" }
            }
          }
        },
        "status": { "type": "string" },
        "totalBill": { "type": "string" },
        "deliveryDate": { "type": "string", "format": "date" },
        "additionalDetails": { "type": "string" },
        "referenceImages": { "type": "array", "items": { "type": "string" } },
        "previews": { "type": "array", "items": { "type": "string" } },
        "adminId": { "type": "string" },
        "assignedStaffId": { "type": "string" },
        "priority": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "OrderUpdate": {
      "title": "OrderUpdate",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderId": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "senderRole": { "type": "string" },
        "message": { "type": "string" },
        "fileUrl": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "CatalogItem": {
      "title": "CatalogItem",
      "type": "object",
      "description": "Represents a product or service offered by the shop.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "subCategory": { "type": "string" },
        "imageUrl": { "type": "string" },
        "startingPrice": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "category"]
    },
    "Category": {
      "title": "Category",
      "type": "object",
      "description": "Dynamic work categories.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name"]
    },
    "Subcategory": {
      "title": "Subcategory",
      "type": "object",
      "description": "Subcategories nested under a category.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name"]
    }
  },
  "auth": {
    "providers": ["password", "google"]
  },
  "firestore": {
    "/users/{userId}": { "schema": "#/backend/entities/User", "description": "User profiles." },
    "/orders/{orderId}": { "schema": "#/backend/entities/Order", "description": "Print orders." },
    "/orders/{orderId}/updates/{updateId}": { "schema": "#/backend/entities/OrderUpdate", "description": "Messages for an order." },
    "/catalog/{itemId}": { "schema": "#/backend/entities/CatalogItem", "description": "Products in the catalog." },
    "/categories/{categoryId}": { "schema": "#/backend/entities/Category", "description": "Customizable work categories." },
    "/categories/{categoryId}/subcategories/{subcategoryId}": { "schema": "#/backend/entities/Subcategory", "description": "Subcategories for a category." }
  }
}
