
{
  "entities": {
    "Shop": {
      "title": "Shop",
      "type": "object",
      "description": "Represents a tenant shop in the system.",
      "properties": {
        "id": { "type": "string" },
        "shopName": { "type": "string" },
        "ownerId": { "type": "string" },
        "address": { "type": "string" },
        "phone": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "shopName", "ownerId"]
    },
    "User": {
      "title": "User",
      "type": "object",
      "description": "System users including super admins, shop owners, and staff.",
      "properties": {
        "id": { "type": "string" },
        "shopId": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["super_admin", "shop_owner", "staff"] },
        "status": { "type": "string", "enum": ["Active", "Inactive"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "email", "role"]
    }
  },
  "auth": {
    "providers": ["password", "google"]
  },
  "firestore": {
    "/shops/{shopId}": { "schema": "#/backend/entities/Shop", "description": "Tenants." },
    "/users/{userId}": { "schema": "#/backend/entities/User", "description": "Profiles." },
    "/orders/{orderId}": { "schema": "#/backend/entities/Order", "description": "Shop-specific orders." },
    "/attendance/{attendanceId}": { "schema": "#/backend/entities/Attendance", "description": "Attendance logs." }
  }
}
