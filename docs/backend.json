
{
  "entities": {
    "User": {
      "title": "User",
      "type": "object",
      "description": "Represents an administrative or staff user. Roles: 'admin', 'staff'.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "username": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "photoUrl": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "staff"] },
        "password": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "username", "email", "role"]
    },
    "Order": {
      "title": "Order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "billNumber": { "type": "string", "description": "Manual bill number for tracking." },
        "customerName": { "type": "string" },
        "customerEmail": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "workTypes": { 
          "type": "array",
          "items": { "type": "string" },
          "description": "Multiple work types for a single order."
        },
        "orderItems": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": { "type": "string" },
              "size": { "type": "string" },
              "qty": { "type": "string" }
            }
          }
        },
        "status": { "type": "string" },
        "totalBill": { "type": "string" },
        "deliveryDate": { "type": "string", "format": "date" },
        "additionalDetails": { "type": "string" },
        "referenceImages": { "type": "array", "items": { "type": "string" } },
        "previews": { "type": "array", "items": { "type": "string" } },
        "adminId": { "type": "string" },
        "assignedStaffId": { "type": "string" },
        "priority": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "OrderUpdate": {
      "title": "OrderUpdate",
      "type": "object",
      "description": "Messages/Notes between Admin and Staff for a specific order.",
      "properties": {
        "id": { "type": "string" },
        "orderId": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "senderRole": { "type": "string" },
        "message": { "type": "string" },
        "fileUrl": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["password", "google"]
  },
  "firestore": {
    "/users/{userId}": { "schema": "#/backend/entities/User", "description": "User profiles with roles." },
    "/orders/{orderId}": { "schema": "#/backend/entities/Order", "description": "Print orders." },
    "/orders/{orderId}/updates/{updateId}": { "schema": "#/backend/entities/OrderUpdate", "description": "Messages for an order." }
  }
}
